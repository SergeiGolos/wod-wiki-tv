<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Android TV. -->
    <style name="Theme.WodWikiTv" parent="@style/Theme.Leanback">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/themes.xml, while customizations related to
            backward-compatibility can go here.
        -->
        <!--
            Remove default title bar for a more immersive TV experience,
            especially when using Jetpack Compose which doesn't use the ActionBar/Toolbar.
        -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- Set background color -->
        <item name="android:windowBackground">@color/background_color</item>

        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/primary_dark_color</item> <!-- For older themes -->
        <item name="colorOnPrimary">@color/text_color_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_color</item>
        <item name="colorSecondaryVariant">@color/accent_color</item> <!-- For older themes -->
        <item name="colorOnSecondary">@color/background_color</item> <!-- Text/icons on accent color -->

        <!-- Status bar color. (Less relevant for TV, but good practice) -->
        <item name="android:statusBarColor">@color/primary_dark_color</item>

        <!-- Customize Leanback specific attributes if mixing with Leanback components -->
        <item name="browseRowsFadingEdgeLength">0dp</item>
        <item name="browseRowsMarginStart">48dp</item>
        <item name="browseRowsMarginEnd">48dp</item>
    </style>

    <!-- Specific theme for Jetpack Compose activities if needed, though the above should work.
         Ensure it uses a Compose-compatible parent if not extending Theme.Leanback or similar.
         For a pure Compose app, a more minimal parent theme might be used.
         However, Theme.Leanback provides necessary TV focus behavior defaults.
    -->
    <style name="Theme.WodWikiTv.Compose" parent="Theme.Leanback">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/background_color</item>
    </style>
</resources>
